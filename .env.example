# ==============================================================================
# ChatCine — Variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
# ==============================================================================

# --- APIs externas -----------------------------------------------------------

# Chave da API Ollama Cloud (respostas de IA do chat)
# https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Modelo de IA a usar (opcional — padrão: gpt-oss:120b-cloud)
# Outros exemplos: qwen3-coder:480b-cloud, deepseek-v3.1:671b-cloud
# OLLAMA_MODEL=gpt-oss:120b-cloud

# Chave da API TMDB (busca de filmes e recomendações)
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Segurança ---------------------------------------------------------------

# Segredo usado para assinar os tokens JWT (troque em produção)
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production

# --- Transcrição de áudio (opcional) -----------------------------------------
# Se não configurado, o envio de áudio retorna "serviço não configurado".

# Caminho para o arquivo de credenciais do Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=

# Ou o JSON das credenciais direto na variável (alternativa ao arquivo acima)
GOOGLE_CREDENTIALS_JSON=

# --- Servidor ----------------------------------------------------------------

# Porta do Next.js (padrão: 3000)
PORT=3000

# URL base da API usada pelo cliente (padrão: relativo "/api")
# NEXT_PUBLIC_API_URL=/api
